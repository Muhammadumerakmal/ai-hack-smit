{
  "name": "hcm-lite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:push:local": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "dev:seed": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/dev-seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-three/fiber": "^9.8.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.0",
    "next": "16.4.3",
    "openai": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
