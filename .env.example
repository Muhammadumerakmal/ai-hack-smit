# Copy to .env and fill in. Never commit .env.

# Postgres. Local: `docker compose up -d` gives the URL below. Hosted: Neon / Supabase connection string.
DATABASE_URL="postgresql://hcm:hcm@localhost:5432/hcm?schema=public"

# Optional: first-run setup can take the Admin account from here instead of the form.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Signs the login JWT. Any long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# AI assistant (M8). Server-side only; the browser never sees it.
AI_API_KEY="sk-..."
AI_MODEL="gpt-4.1-mini"
# Optional: any OpenAI-compatible endpoint (e.g. Groq, OpenRouter)
AI_BASE_URL=""
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20

# Company timezone for "today", late time and leave dates
APP_TZ="Asia/Karachi"
