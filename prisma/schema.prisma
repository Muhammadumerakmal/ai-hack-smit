// HCM Lite data model.
// M8 (AI assistant) only reads these tables through the services in src/server/services
// and writes only to ai_logs and the chat history tables. The other modules own the writes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  INACTIVE
  EXITED
}

/// Stored statuses. "absent" and "on_leave" are derived (no record), see attendance.service.ts.
enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  MISSING_CHECKOUT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

/// One row per company (tenant). Every other table belongs to exactly one company through companyId,
/// and src/lib/db.ts scopes every query to the signed-in user's company. Settings apply to new records only.
model CompanySettings {
  id                 Int      @id @default(autoincrement())
  companyName        String
  officeStart        String   @default("09:00")
  graceMinutes       Int      @default(15)
  halfDayHours       Float    @default(5)
  /// 0 = Sunday … 6 = Saturday
  weekendDays        Int[]    @default([0, 6])
  officeLat          Float?
  officeLng          Float?
  radiusMeters       Int      @default(150)
  /// Bonus rule: every 3 late days in a month deduct half a day of pay (off by default; Section 3 has no such rule)
  latePenaltyEnabled Boolean  @default(false)
  /// When on, the plain web check-in is refused: face + location (camera check-in) only
  cameraRequired     Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  users                 User[]
  departments           Department[]
  designations          Designation[]
  employees             Employee[]
  attendanceCorrections AttendanceCorrection[]
  leaveTypes            LeaveType[]
  holidays              Holiday[]
  attendance            Attendance[]
  leaveRequests         LeaveRequest[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  announcements         Announcement[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  aiLogs                AiLog[]
  chatConversations     ChatConversation[]
  chatMessages          ChatMessage[]
  faceProfiles          FaceProfile[]
  pushSubscriptions     PushSubscription[]

  @@map("settings")
}

model User {
  id                 String   @id @default(cuid())
  companyId          Int
  email              String   @unique
  name               String   @default("")
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  employee          Employee?
  aiLogs            AiLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  conversations     ChatConversation[]

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("users")
}

model Department {
  id        String     @id @default(cuid())
  companyId Int
  name      String
  employees Employee[]

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Designation {
  id        String     @id @default(cuid())
  companyId Int
  title     String
  employees Employee[]

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([companyId, title])
  @@index([companyId])
  @@map("designations")
}

model Employee {
  id            String         @id @default(cuid())
  companyId     Int
  code          String
  fullName      String
  email         String         @unique
  phone         String?
  address       String?
  gender        String?
  departmentId  String
  designationId String?
  joinDate      DateTime       @db.Date
  exitDate      DateTime?      @db.Date
  status        EmployeeStatus @default(PROBATION)
  basicSalary   Decimal        @db.Decimal(12, 2)
  userId        String?        @unique

  department    Department             @relation(fields: [departmentId], references: [id])
  designation   Designation?           @relation(fields: [designationId], references: [id])
  user          User?                  @relation(fields: [userId], references: [id])
  attendance    Attendance[]
  corrections   AttendanceCorrection[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  faceProfile   FaceProfile?
  company       CompanySettings        @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([departmentId])
  @@index([companyId])
  @@map("employees")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Employee asks HR to fix a day's attendance; on approval the attendance row is created or replaced.
model AttendanceCorrection {
  id                String        @id @default(cuid())
  companyId         Int
  employeeId        String
  date              DateTime      @db.Date
  requestedCheckIn  DateTime
  requestedCheckOut DateTime?
  reason            String
  status            RequestStatus @default(PENDING)
  decidedById       String?
  decisionComment   String?
  createdAt         DateTime      @default(now())

  employee Employee        @relation(fields: [employeeId], references: [id])
  company  CompanySettings @relation(fields: [companyId], references: [id])

  @@index([status])
  @@index([companyId])
  @@map("attendance_corrections")
}

model LeaveType {
  id          String         @id @default(cuid())
  companyId   Int
  /// annual | sick | casual | unpaid (or any code Admin adds)
  code        String
  name        String
  /// null = unlimited (unpaid)
  yearlyQuota Int?
  isPaid      Boolean        @default(true)
  requests    LeaveRequest[]

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

model Holiday {
  id        String   @id @default(cuid())
  companyId Int
  date      DateTime @db.Date
  name      String

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@map("holidays")
}

model Attendance {
  id             String           @id @default(cuid())
  companyId      Int
  employeeId     String
  date           DateTime         @db.Date
  checkIn        DateTime
  checkOut       DateTime?
  status         AttendanceStatus
  /// web | camera | correction
  source         String           @default("web")
  /// Camera check-in only: the result of the server's geofence check. No photo and no raw coordinates are stored.
  distanceMeters Int?
  gpsAccuracy    Int?
  /// true when the face matched the employee's enrolled face; null when no face is enrolled
  faceVerified   Boolean?

  employee Employee        @relation(fields: [employeeId], references: [id])
  company  CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([companyId])
  @@map("attendance")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  companyId       Int
  employeeId      String
  leaveTypeId     String
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  /// working days, computed when the request is created
  days            Int
  reason          String
  status          LeaveStatus @default(PENDING)
  decidedById     String?
  decisionComment String?
  createdAt       DateTime    @default(now())

  employee  Employee        @relation(fields: [employeeId], references: [id])
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  company   CompanySettings @relation(fields: [companyId], references: [id])

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@index([companyId])
  @@map("leave_requests")
}

model PayrollRun {
  id            String        @id @default(cuid())
  companyId     Int
  /// "2026-10"
  month         String
  status        PayrollStatus @default(DRAFT)
  createdById   String
  finalizedById String?
  finalizedAt   DateTime?
  createdAt     DateTime      @default(now())
  payslips      Payslip[]

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([companyId, month])
  @@index([companyId])
  @@map("payroll_runs")
}

model Payslip {
  id              String  @id @default(cuid())
  companyId       Int
  runId           String
  employeeId      String
  basic           Decimal @db.Decimal(12, 2)
  hra             Decimal @db.Decimal(12, 2)
  medical         Decimal @db.Decimal(12, 2)
  gross           Decimal @db.Decimal(12, 2)
  deductions      Decimal @db.Decimal(12, 2)
  tax             Decimal @db.Decimal(12, 2)
  net             Decimal @db.Decimal(12, 2)
  workingDays     Int
  paidDays        Float
  lateDays        Int     @default(0)
  /// 0.5 day per 3 late days, only when the late penalty rule is on (included in deductions)
  latePenaltyDays Float   @default(0)

  run      PayrollRun      @relation(fields: [runId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id])
  company  CompanySettings @relation(fields: [companyId], references: [id])

  @@unique([runId, employeeId])
  @@index([companyId])
  @@map("payslips")
}

model Announcement {
  id         String   @id @default(cuid())
  companyId  Int
  title      String
  body       String
  authorId   String
  authorName String
  createdAt  DateTime @default(now())

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("announcements")
}

model Notification {
  id        String    @id @default(cuid())
  companyId Int
  userId    String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id])
  company CompanySettings @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@map("notifications")
}

/// Append-only. There is no update or delete path for this table anywhere in the app.
model AuditLog {
  id        String          @id @default(cuid())
  companyId Int
  actorId   String
  actorRole Role
  actorName String
  /// create | update | approve | reject | finalize | deactivate | reset_password | ...
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime        @default(now())
  company   CompanySettings @relation(fields: [companyId], references: [id])

  @@index([createdAt])
  @@index([companyId])
  @@map("audit_logs")
}

/// Every AI call, including failures and refusals.
model AiLog {
  id               String   @id @default(cuid())
  companyId        Int
  userId           String
  role             Role
  /// chat | summary | smart_leave
  feature          String
  input            String
  toolCalls        Json?
  output           String?
  /// ok | error | timeout | invalid_output | rate_limited
  status           String
  latencyMs        Int
  model            String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id])
  company CompanySettings @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt])
  @@index([companyId])
  @@map("ai_logs")
}

/// One assistant conversation. The server owns the history (OpenAI Agents SDK Session, see src/server/ai/chat-session.ts),
/// so the browser can never inject assistant or tool turns. The id is a UUID generated by the browser.
model ChatConversation {
  id        String   @id
  companyId Int
  userId    String
  /// first question, shortened, for the history list
  title     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  company  CompanySettings @relation(fields: [companyId], references: [id])

  @@index([userId, updatedAt])
  @@index([companyId])
  @@map("chat_conversations")
}

/// Plain user/assistant text only. Tool calls and tool results (salaries, balances) are never stored:
/// the model re-reads fresh data through tools on every turn.
model ChatMessage {
  id             Int      @id @default(autoincrement())
  companyId      Int
  conversationId String
  /// user | assistant
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      CompanySettings  @relation(fields: [companyId], references: [id])

  @@index([conversationId, id])
  @@index([companyId])
  @@map("chat_messages")
}

/// Camera check-in face matching (Section 5 extra bonus). One enrolled face per employee:
/// a 128-number face descriptor computed in the browser, never a photo. Kept out of the Employee row
/// so it can never leak through employee responses or audit before/after JSON. HR can delete it.
model FaceProfile {
  employeeId String   @id
  companyId  Int
  descriptor Float[]
  enrolledAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  company CompanySettings @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("face_profiles")
}

/// A browser/phone that asked for push alerts (Web Push). One row per device endpoint; the keys encrypt each
/// message for that device only. Removed when the user turns alerts off or the push service says it expired.
model PushSubscription {
  id        String   @id @default(cuid())
  companyId Int
  userId    String
  /// push service URL for this device (unique: re-subscribing the same device updates the row)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  company CompanySettings @relation(fields: [companyId], references: [id])
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("push_subscriptions")
}
